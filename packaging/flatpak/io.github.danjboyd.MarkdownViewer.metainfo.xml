<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.danjboyd.MarkdownViewer</id>
  <name>MarkdownViewer</name>
  <summary>Read, edit and preview Markdown documents</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later AND LGPL-2.1-or-later</project_license>
  <developer id="io.github.danjboyd">
    <name>Daniel Boyd</name>
  </developer>
  <description>
    <p>
      MarkdownViewer is a GNUstep Markdown reader and editor: rendered previews with
      tables, math, Mermaid diagrams and highlighted code, a source editor with linked
      scrolling, an explorer and an outline. It takes its look from the GNUstep theme,
      here Adwaita.
    </p>
  </description>
  <launchable type="desktop-id">io.github.danjboyd.MarkdownViewer.desktop</launchable>
  <url type="homepage">https://github.com/danjboyd/ObjcMarkdown</url>
  <url type="bugtracker">https://github.com/danjboyd/ObjcMarkdown/issues</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/danjboyd/ObjcMarkdown/main/docs/screenshots/adwaita-read.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
</component>
