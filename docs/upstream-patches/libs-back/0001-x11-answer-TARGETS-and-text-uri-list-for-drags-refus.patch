@@ -44,6 +44,7 @@
 #include <Foundation/NSRunLoop.h>
 #include <Foundation/NSDebug.h>
 #include <Foundation/NSDistributedNotificationCenter.h>
+#include <Foundation/NSURL.h>
 
 #include "x11/XGServerWindow.h"
