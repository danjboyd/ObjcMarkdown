+/* Tells the requestor of a selection that its request is done: property
+ * holds the data, or is None when the request is refused (ICCCM 2.2).
+ */
+static void
+sendSelectionNotify(Display *display, XSelectionRequestEvent *request,
+  Atom property)
+{
+  XEvent	reply;
+
+  memset(&reply, 0, sizeof(reply));
+  reply.xselection.type = SelectionNotify;
+  reply.xselection.display = request->display;
+  reply.xselection.requestor = request->requestor;
+  reply.xselection.selection = request->selection;
+  reply.xselection.target = request->target;
+  reply.xselection.property = property;
+  reply.xselection.time = request->time;
+  XSendEvent(display, request->requestor, False, 0, &reply);
+}
+
 /*
   Mouse properties. In comments below specified defaults key and default value.
 */
@@ -1890,7 +1911,37 @@ posixFileDescriptor: (NSPosixFileDescriptor*)fileDescriptor
           NSPasteboard *pb = [NSPasteboard pasteboardWithName: NSDragPboard];
           NSArray *types = [pb types];
           NSData *data = nil;
-          Atom xType = xEvent.xselectionrequest.target;
+          XSelectionRequestEvent *request = &xEvent.xselectionrequest;
+          Atom xType = request->target;
+          Atom targetsAtom = XInternAtom(dpy, "TARGETS", False);
+          Atom uriListAtom = XInternAtom(dpy, "text/uri-list", False);
+
+          if (xType == targetsAtom)
+            {
+              /* A drop target first asks which types it can have, as
+               * ICCCM requires; GTK, for one, asks for nothing else until
+               * it knows.
+               */
+              Atom	targets[5];
+              int	count = 0;
+
+              targets[count++] = targetsAtom;
+              if ([types containsObject: NSStringPboardType])
+                {
+                  targets[count++] = generic.UTF8_STRING_ATOM;
+                  targets[count++] = XA_STRING;
+                  targets[count++] = generic.TEXT_ATOM;
+                }
+              if ([types containsObject: NSFilenamesPboardType])
+                {
+                  targets[count++] = uriListAtom;
+                }
+              XChangeProperty(dpy, request->requestor, request->property,
+                              XA_ATOM, 32, PropModeReplace,
+                              (unsigned char *)targets, count);
+              sendSelectionNotify(dpy, request, request->property);
+              break;
+            }
 
           if (((xType == generic.UTF8_STRING_ATOM) || 
                (xType == XA_STRING) || 
@@ -1908,6 +1959,33 @@ posixFileDescriptor: (NSPosixFileDescriptor*)fileDescriptor
                   data = [s dataUsingEncoding: NSISOLatin1StringEncoding];
                 }
             }
+          else if ((xType == uriListAtom)
+            && [types containsObject: NSFilenamesPboardType])
+            {
+              /* Dragged files, as file managers and browsers take them:
+               * one file URI per line, each line ending in CRLF
+               * (RFC 2483).
+               */
+              NSArray		*names;
+              NSMutableString	*list;
+              NSEnumerator	*e;
+              NSString		*name;
+
+              names = [pb propertyListForType: NSFilenamesPboardType];
+              list = [NSMutableString string];
+              e = [names objectEnumerator];
+              while ((name = [e nextObject]) != nil)
+                {
+                  NSURL	*url = [NSURL fileURLWithPath: name];
+
+                  [list appendString: [url absoluteString]];
+                  [list appendString: @"\r\n"];
+                }
+              if ([list length] > 0)
+                {
+                  data = [list dataUsingEncoding: NSUTF8StringEncoding];
+                }
+            }
           // FIXME: Add support for more types. See: xpbs.m
 
           if (data != nil)
@@ -1915,8 +1993,15 @@ posixFileDescriptor: (NSPosixFileDescriptor*)fileDescriptor
               DndClass dnd = xdnd();
 
               // Send the data to the other process
-              xdnd_selection_send(&dnd, &xEvent.xselectionrequest, 
-                                  (unsigned char *)[data bytes], [data length]);        
+              xdnd_selection_send(&dnd, request,
+                                  (unsigned char *)[data bytes], [data length]);
+            }
+          else
+            {
+              /* Refuse what we can't give at once, rather than leave the
+               * requestor waiting for a reply that never comes.
+               */
+              sendSelectionNotify(dpy, request, None);
             }
         }
         break;
diff --git a/Tests/x11/xdndfilenames.m b/Tests/x11/xdndfilenames.m
new file mode 100644
index 0000000..728ea77
--- /dev/null
+++ b/Tests/x11/xdndfilenames.m
@@ -0,0 +1,249 @@
+/* Dragging files out to other X clients.  A drag of file names offers the
+ * drop target text/uri-list (the MIME type of NSFilenamesPboardType).  The
+ * target then asks for TARGETS on XdndSelection, as ICCCM requires, and
+ * then for the data.  The backend must list the types it offers, answer
+ * text/uri-list with the files as file URIs, one per line, each line
+ * ending in CRLF (RFC 2483), and refuse other types at once; otherwise
+ * file managers and browsers refuse the drop.
+ *
+ * The test plays the drop target from a second X connection: it makes a
+ * GNUstep window the owner of XdndSelection on the backend's connection (as
+ * starting a drag does), asks for a target with XConvertSelection, lets the
+ * backend handle the request while the application waits for events, and
+ * reads back what the backend wrote.  No window manager and no drag are
+ * needed: the backend answers any SelectionRequest from the drag
+ * pasteboard.
+ */
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+#include "config.h"
+
+#if defined(BUILD_SERVER) && defined(SERVER_x11) && BUILD_SERVER == SERVER_x11
+
+#import <AppKit/AppKit.h>
+#import <GNUstepGUI/GSDisplayServer.h>
+#include <X11/Xlib.h>
+#include <X11/Xatom.h>
+
+/* Makes the backend's connection the owner of XdndSelection, as starting a
+ * drag does, then asks for target from dpy, the way a drop target does.
+ * Returns what the backend sent (for 32-bit data, the values as an array of
+ * Atom), or nil if it refused or didn't answer within five seconds.
+ * *type is the property's type, *answered whether a SelectionNotify came.
+ * (The X server sends a SelectionRequest to the client that set the owner,
+ * so the owner must be set on the backend's connection.)
+ */
+static NSData *
+requestDropData(Display *dpy, GSDisplayServer *srv, Window owner, Atom target,
+  Atom *type, BOOL *answered)
+{
+  Display	*backend = (Display *)[srv serverDevice];
+  Atom		selection = XInternAtom(dpy, "XdndSelection", False);
+  Atom		property = XInternAtom(dpy, "GS_TEST_DROP_DATA", False);
+  Window	requestor;
+  XEvent	event;
+  NSData	*result = nil;
+  int		i;
+
+  *type = None;
+  *answered = NO;
+  requestor = XCreateSimpleWindow(dpy, DefaultRootWindow(dpy),
+    0, 0, 1, 1, 0, 0, 0);
+  XSetSelectionOwner(backend, XInternAtom(backend, "XdndSelection", False),
+    owner, CurrentTime);
+  XSync(backend, False);
+  XConvertSelection(dpy, selection, target, property, requestor, CurrentTime);
+  XFlush(dpy);
+
+  for (i = 0; i < 100 && *answered == NO; i++)
+    {
+      [NSApp nextEventMatchingMask: NSAnyEventMask
+			 untilDate: [NSDate dateWithTimeIntervalSinceNow: 0.05]
+			    inMode: NSDefaultRunLoopMode
+			   dequeue: YES];
+      if (XCheckTypedWindowEvent(dpy, requestor, SelectionNotify, &event))
+	{
+	  *answered = YES;
+	}
+    }
+
+  if (*answered && event.xselection.property != None)
+    {
+      Atom		actualType;
+      int		actualFormat;
+      unsigned long	count;
+      unsigned long	remaining;
+      unsigned char	*bytes = NULL;
+
+      if (XGetWindowProperty(dpy, requestor, property, 0, 65536, True,
+	AnyPropertyType, &actualType, &actualFormat, &count, &remaining,
+	&bytes) == Success && bytes != NULL)
+	{
+	  if (actualFormat == 8)
+	    {
+	      result = [NSData dataWithBytes: bytes length: count];
+	    }
+	  else if (actualFormat == 32)
+	    {
+	      /* Xlib returns 32-bit items as longs. */
+	      result = [NSData dataWithBytes: bytes
+				      length: count * sizeof(Atom)];
+	    }
+	  *type = actualType;
+	  XFree(bytes);
+	}
+    }
+  XDestroyWindow(dpy, requestor);
+  XFlush(dpy);
+  return result;
+}
+
+/* Whether a TARGETS answer lists atom. */
+static BOOL
+listsTarget(NSData *targets, Atom atom)
+{
+  const Atom	*atoms = (const Atom *)[targets bytes];
+  NSUInteger	count = [targets length] / sizeof(Atom);
+  NSUInteger	i;
+
+  for (i = 0; i < count; i++)
+    {
+      if (atoms[i] == atom)
+	{
+	  return YES;
+	}
+    }
+  return NO;
+}
+
+static NSString *
+utf8String(NSData *data)
+{
+  if (data == nil)
+    {
+      return nil;
+    }
+  return [[[NSString alloc] initWithData: data
+				encoding: NSUTF8StringEncoding] autorelease];
+}
+
+int
+main(int argc, const char **argv)
+{
+  START_SET("XDND file drags")
+
+  NSAutoreleasePool	*pool = [NSAutoreleasePool new];
+  Display		*dpy;
+  BOOL			started = NO;
+  NSWindow		*win;
+  GSDisplayServer	*srv;
+  Window		owner;
+  NSPasteboard		*pb;
+  Atom			uriList;
+  Atom			utf8;
+  Atom			targetsAtom;
+  Atom			type;
+  BOOL			answered;
+  NSData		*data;
+  NSArray		*names;
+
+  if (getenv("DISPLAY") == NULL || *getenv("DISPLAY") == '\0')
+    {
+      SKIP("no window server available")
+    }
+  dpy = XOpenDisplay(NULL);
+  if (dpy == NULL)
+    {
+      SKIP("no window server available")
+    }
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+      started = YES;
+    }
+  NS_HANDLER
+    {
+      NSLog(@"the application did not start: %@", localException);
+    }
+  NS_ENDHANDLER
+  if (started == NO || GSCurrentServer() == nil
+    || [GSCurrentServer() isMemberOfClass: [GSDisplayServer class]])
+    {
+      SKIP("It looks like the GNUstep backend is not installed")
+    }
+
+  win = [[NSWindow alloc] initWithContentRect: NSMakeRect(100, 100, 200, 100)
+				    styleMask: NSTitledWindowMask
+				      backing: NSBackingStoreBuffered
+					defer: NO];
+  [win orderFront: nil];
+  srv = GSServerForWindow(win);
+  owner = (Window)[srv windowDevice: [win windowNumber]];
+  XSync((Display *)[srv serverDevice], False);
+
+  uriList = XInternAtom(dpy, "text/uri-list", False);
+  utf8 = XInternAtom(dpy, "UTF8_STRING", False);
+  targetsAtom = XInternAtom(dpy, "TARGETS", False);
+  pb = [NSPasteboard pasteboardWithName: NSDragPboard];
+
+  /* Two files, one with a space in its name. */
+  names = [NSArray arrayWithObjects:
+    @"/tmp/xdnd test/a b.txt", @"/tmp/c.pdf", nil];
+  [pb declareTypes: [NSArray arrayWithObject: NSFilenamesPboardType]
+	     owner: nil];
+  [pb setPropertyList: names forType: NSFilenamesPboardType];
+
+  data = requestDropData(dpy, srv, owner, targetsAtom, &type, &answered);
+  PASS(data != nil && type == XA_ATOM,
+    "a drag of files answers TARGETS with a list of atoms");
+  PASS(listsTarget(data, uriList) && listsTarget(data, targetsAtom),
+    "the list has text/uri-list and TARGETS");
+  PASS(listsTarget(data, utf8) == NO,
+    "the list doesn't offer text the drag doesn't have");
+
+  data = requestDropData(dpy, srv, owner, uriList, &type, &answered);
+  PASS(data != nil && type == uriList,
+    "a drag of files answers text/uri-list");
+  PASS_EQUAL(utf8String(data),
+    @"file:///tmp/xdnd%20test/a%20b.txt\r\nfile:///tmp/c.pdf\r\n",
+    "it lists every file as a file URI, each line ending in CRLF");
+
+  data = requestDropData(dpy, srv, owner, utf8, &type, &answered);
+  PASS(answered && data == nil,
+    "a drag of files refuses UTF8_STRING at once");
+
+  /* Text: the existing path, and TARGETS for it. */
+  [pb declareTypes: [NSArray arrayWithObject: NSStringPboardType] owner: nil];
+  [pb setString: @"dragged text" forType: NSStringPboardType];
+  data = requestDropData(dpy, srv, owner, utf8, &type, &answered);
+  PASS_EQUAL(utf8String(data), @"dragged text",
+    "a drag of text still answers UTF8_STRING");
+  data = requestDropData(dpy, srv, owner, targetsAtom, &type, &answered);
+  PASS(listsTarget(data, utf8) && listsTarget(data, uriList) == NO,
+    "a drag of text lists UTF8_STRING and not text/uri-list");
+  data = requestDropData(dpy, srv, owner, uriList, &type, &answered);
+  PASS(answered && data == nil,
+    "a drag of text refuses text/uri-list at once");
+
+  [win orderOut: nil];
+  [win release];
+  XCloseDisplay(dpy);
+  [pool release];
+
+  END_SET("XDND file drags")
+  return 0;
+}
+
+#else
+
+int
+main(int argc, const char **argv)
+{
+  START_SET("XDND file drags")
+    SKIP("back is not built with the x11 server")
+  END_SET("XDND file drags")
+  return 0;
+}
+
+#endif
